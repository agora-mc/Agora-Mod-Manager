{
  "contract": 1,
  "games": ["minecraft"],
  "sources": [
    {
      "id": "crash_report",
      "where": { "root": "instance", "path": "crash-reports" },
      "match": { "glob": "crash-*.txt" },
      "format": "crash_report",
      "bind": [{ "time": { "before_s": 5, "after_s": 30 } }],
      "role": "primary"
    },
    {
      "id": "latest_log",
      "where": { "root": "instance", "path": "logs" },
      "match": { "glob": "latest.log" },
      "format": "latest_log",
      "copy": "head_tail",
      "privacy": "personal"
    },
    {
      "id": "hs_err_root",
      "where": { "root": "instance", "path": "" },
      "match": { "glob": "hs_err_pid*.log" },
      "format": "hs_err",
      "copy": "facts_only"
    },
    {
      "id": "hs_err_logs",
      "where": { "root": "instance", "path": "logs" },
      "match": { "glob": "hs_err_pid*.log" },
      "format": "hs_err",
      "copy": "facts_only"
    }
  ],
  "parsers": [
    {
      "id": "crash_report",
      "entry": { "built_in": { "name": "crash_report" } },
      "detect": {
        "all": ["---- Minecraft Crash Report ----"]
      }
    },
    {
      "id": "latest_log",
      "entry": { "built_in": { "name": "latest_log" } },
      "detect": {
        "any": [
          "(?m)^\\[[^\\]\\n]*\\d\\d:\\d\\d:\\d\\d[^\\]\\n]*\\] \\[[^\\]\\n/]+/(INFO|WARN|ERROR|DEBUG|FATAL)\\]",
          "(?m)^Loading Minecraft "
        ]
      }
    },
    {
      "id": "hs_err",
      "entry": { "built_in": { "name": "hs_err" } },
      "detect": {
        "all": ["(?m)^# A fatal error has been detected by the Java Runtime Environment:$"]
      }
    },
    {
      "id": "snippet",
      "entry": { "built_in": { "name": "snippet" } },
      "reads": "snippet",
      "detect": {
        "any": [
          "(?m)^\\s*(?:Caused by: |Suppressed: )?[A-Za-z_$][A-Za-z0-9_$.]*\\.[A-Za-z0-9_$]+(?:Exception|Error|Throwable)\\b",
          "(?m)^Exception in thread\\s+\"[^\"]*\"\\s+\\S*(?:Exception|Error|Throwable)\\b",
          "(?m)^\\s*at\\s+[A-Za-z_$][A-Za-z0-9_$.]*\\(",
          "(?im)(?:Mixin (?:apply|prepare)|was loaded too early|InvalidInjectionException|ClassMetadataNotFoundException)",
          "(?im)(?:duplicate (?:asm )?classes found on classpath|ModResolutionException|incompatible mod set|missing or unsupported mandatory dependencies)",
          "(?m)^\\s*-\\s*Mod '[^']*' \\([^)]*\\) .* requires .*, which is (?:missing|disabled|incompatible)!",
          "(?m)OutOfMemoryError"
        ]
      }
    }
  ],
  "ref_maps": [
    { "kind": "mod_id", "lookup": { "index": "mod_id" }, "match": "exact" },
    { "kind": "class", "lookup": { "index": "java_package" }, "match": "prefix_dot" },
    {
      "kind": "class",
      "lookup": { "facts": { "kind": "minecraft.mod", "key": "id", "name": "name" } },
      "match": "segment",
      "ignore": [
        "client", "server", "common", "api", "core", "mixin", "util", "lib", "impl",
        "mod", "mods", "net", "com", "org", "io", "me", "dev"
      ]
    },
    {
      "kind": "mixin_config",
      "lookup": { "facts": { "kind": "minecraft.mod", "key": "id", "name": "name" } },
      "match": "segment",
      "ignore": [
        "client", "server", "common", "api", "core", "mixin", "mixins", "util", "lib",
        "impl", "mod", "mods", "net", "com", "org", "io", "me", "dev", "json"
      ]
    },
    {
      "kind": "named_class",
      "lookup": { "facts": { "kind": "minecraft.mod", "key": "id", "name": "name" } },
      "match": "segment",
      "ignore": [
        "client", "server", "common", "api", "core", "mixin", "util", "lib", "impl",
        "mod", "mods", "net", "com", "org", "io", "me", "dev"
      ]
    },
    {
      "kind": "needed_by",
      "lookup": { "facts": { "kind": "minecraft.mod", "key": "id", "name": "name" } },
      "match": "segment",
      "ignore": [
        "client", "server", "common", "api", "core", "mixin", "util", "lib", "impl",
        "mod", "mods", "net", "com", "org", "io", "me", "dev"
      ]
    },
    { "kind": "needed_by", "lookup": { "index": "mod_id" }, "match": "exact" },
    {
      "kind": "file",
      "lookup": { "path": { "patterns": ["mods/{value}", "mods/*/{value}"], "archives": true } },
      "match": "casefold"
    }
  ],
  "roles": [
    { "kind": "class", "value": "java", "match": "prefix_dot", "role": "system" },
    { "kind": "class", "value": "jdk", "match": "prefix_dot", "role": "system" },
    { "kind": "class", "value": "sun", "match": "prefix_dot", "role": "system" },
    { "kind": "class", "value": "javax", "match": "prefix_dot", "role": "system" },
    { "kind": "class", "value": "net.minecraft", "match": "prefix_dot", "role": "platform" },
    { "kind": "class", "value": "net.fabricmc", "match": "prefix_dot", "role": "platform" },
    { "kind": "class", "value": "net.minecraftforge", "match": "prefix_dot", "role": "platform" },
    { "kind": "class", "value": "net.neoforged", "match": "prefix_dot", "role": "platform" },
    { "kind": "class", "value": "cpw.mods", "match": "prefix_dot", "role": "platform" },
    { "kind": "class", "value": "com.mojang", "match": "prefix_dot", "role": "platform" },
    { "kind": "class", "value": "org.lwjgl", "match": "prefix_dot", "role": "platform" },
    { "kind": "class", "value": "org.spongepowered", "match": "prefix_dot", "role": "framework" },
    { "kind": "class", "value": "com.google", "match": "prefix_dot", "role": "framework" },
    { "kind": "class", "value": "org.apache", "match": "prefix_dot", "role": "framework" },
    { "kind": "class", "value": "io.netty", "match": "prefix_dot", "role": "framework" },
    { "kind": "class", "value": "it.unimi", "match": "prefix_dot", "role": "framework" },
    { "kind": "class", "value": "org.slf4j", "match": "prefix_dot", "role": "framework" },
    { "kind": "class", "value": "org.objectweb.asm", "match": "prefix_dot", "role": "framework" },
    { "kind": "class", "value": "com.llamalad7", "match": "prefix_dot", "role": "framework" },
    { "kind": "class", "value": "kotlin", "match": "prefix_dot", "role": "framework" },
    { "kind": "class", "value": "scala", "match": "prefix_dot", "role": "framework" },
    { "kind": "module", "value": "nvoglv64.dll", "match": "casefold", "role": "system" },
    { "kind": "module", "value": "nvoglv32.dll", "match": "casefold", "role": "system" },
    { "kind": "module", "value": "nvwgf2umx.dll", "match": "casefold", "role": "system" },
    { "kind": "module", "value": "igxelpicd64.dll", "match": "casefold", "role": "system" },
    { "kind": "module", "value": "igc64.dll", "match": "casefold", "role": "system" },
    { "kind": "module", "value": "igd10iumd64.dll", "match": "casefold", "role": "system" },
    { "kind": "module", "value": "atio6axx.dll", "match": "casefold", "role": "system" },
    { "kind": "module", "value": "atioglxx.dll", "match": "casefold", "role": "system" },
    { "kind": "module", "value": "amdvlk64.dll", "match": "casefold", "role": "system" },
    { "kind": "module", "value": "opengl32.dll", "match": "casefold", "role": "system" },
    { "kind": "module", "value": "libgl.so", "match": "casefold", "role": "system" },
    { "kind": "module", "value": "libgl.so.1", "match": "casefold", "role": "system" },
    { "kind": "module", "value": "libegl.so", "match": "casefold", "role": "system" },
    { "kind": "module", "value": "libegl.so.1", "match": "casefold", "role": "system" }
  ],
  "rules": [
    {
      "id": "missing_dependency",
      "version": 1,
      "when": {
        "fact": {
          "kind": "core.dependency_problem",
          "where": { "state": "absent" },
          "ref": { "kind": "mod_id", "bind": "missing" },
          "bind": { "needed_by": "needed_by", "requirement": "requirement" }
        }
      },
      "effects": [{ "finding": { "scope": "environment", "level": "likely", "cause": "missing_requirement" } }],
      "text": {
        "headline": {
          "en": "A mod that is installed needs {owner:missing} ({requirement}), and it is not installed. Installing it, or removing the mod that needs it, is a likely next step."
        },
        "why_not_sure": {
          "en": "The loader named the missing mod, but it does not tell us that the crash came from it."
        }
      },
      "next_step": "confirm_experiment"
    },
    {
      "id": "missing_fabric_api",
      "version": 1,
      "supersedes": ["missing_dependency"],
      "when": {
        "fact": {
          "kind": "core.dependency_problem",
          "where": { "state": "absent" },
          "ref": {
            "kind": "mod_id",
            "value": { "in": ["fabric", "fabric-api"] },
            "bind": "missing"
          },
          "bind": { "needed_by": "needed_by" }
        }
      },
      "effects": [{ "finding": { "scope": "environment", "level": "likely", "cause": "missing_requirement" } }],
      "text": {
        "headline": {
          "en": "A mod that is installed needs Fabric API, and it is not installed. Installing Fabric API is a likely next step."
        },
        "why_not_sure": {
          "en": "The loader named Fabric API, but the crash may have another cause as well."
        }
      },
      "next_step": "confirm_experiment"
    },
    {
      "id": "wrong_dependency_version",
      "version": 1,
      "when": {
        "fact": {
          "kind": "core.dependency_problem",
          "where": { "state": "wrong_version" },
          "ref": { "kind": "mod_id", "bind": "bad" },
          "bind": { "requirement": "requirement", "needed_by": "needed_by" }
        }
      },
      "effects": [{ "finding": { "scope": "environment", "level": "likely", "cause": "version_mismatch" } }],
      "text": {
        "headline": {
          "en": "A mod needs {owner:bad} ({requirement}), but a different version is installed. Getting the version the loader asks for is a likely next step."
        },
        "why_not_sure": {
          "en": "The loader only says the requirement was not met; another mod may be involved too."
        }
      },
      "next_step": "confirm_experiment"
    },
    {
      "id": "wrong_game_version",
      "version": 1,
      "supersedes": ["wrong_dependency_version"],
      "when": {
        "fact": {
          "kind": "core.dependency_problem",
          "where": { "state": "wrong_version" },
          "ref": {
            "kind": "mod_id",
            "value": { "in": ["minecraft"] },
            "bind": "wanted"
          },
          "bind": { "requirement": "requirement" }
        }
      },
      "effects": [{ "finding": { "scope": "environment", "level": "likely", "cause": "version_mismatch" } }],
      "text": {
        "headline": {
          "en": "A mod asks for a different game version ({requirement}) than the one that is running. A build of that mod for this game version is a likely next step."
        },
        "why_not_sure": {
          "en": "The loader named the version mismatch, but the crash may still have another cause."
        }
      },
      "next_step": "confirm_experiment"
    },
    {
      "id": "wrong_loader_version",
      "version": 1,
      "supersedes": ["wrong_dependency_version"],
      "when": {
        "fact": {
          "kind": "core.dependency_problem",
          "where": { "state": { "in": ["absent", "wrong_version"] } },
          "ref": {
            "kind": "mod_id",
            "value": { "in": ["fabricloader", "forge", "neoforge", "quilt_loader"] },
            "bind": "wanted"
          },
          "bind": { "requirement": "requirement" }
        }
      },
      "effects": [{ "finding": { "scope": "environment", "level": "possible", "cause": "version_mismatch" } }],
      "text": {
        "headline": {
          "en": "A mod asks for a different version of the mod loader ({requirement}). Updating the loader may help."
        },
        "why_not_sure": {
          "en": "The loader named the requirement, but the crash may come from elsewhere."
        }
      },
      "next_step": "confirm_experiment"
    },
    {
      "id": "out_of_memory",
      "version": 1,
      "when": {
        "fact": {
          "kind": "core.exception",
          "where": { "category": "oom" }
        }
      },
      "effects": [{ "finding": { "scope": "environment", "level": "likely", "cause": "memory" } }],
      "text": {
        "headline": {
          "en": "Java ran out of memory. Giving the instance more memory may help, or a mod may be holding on to more than it should."
        },
        "why_not_sure": {
          "en": "A mod can cause the memory pressure, but the log does not name one."
        }
      },
      "next_step": "confirm_experiment"
    },
    {
      "id": "missing_class",
      "version": 1,
      "when": {
        "fact": {
          "kind": "core.exception",
          "where": {
            "class": {
              "in": ["java.lang.NoClassDefFoundError", "java.lang.ClassNotFoundException"]
            }
          },
          "bind": { "message": "message" }
        }
      },
      "effects": [{ "finding": { "scope": "environment", "level": "possible", "cause": "missing_requirement" } }],
      "text": {
        "headline": {
          "en": "A class the game needed was not found: {message}. A mod that provides it may be missing, disabled, or for another game version."
        },
        "why_not_sure": {
          "en": "The exception names the missing class, not the mod that should have provided it."
        }
      },
      "next_step": "confirm_experiment"
    },
    {
      "id": "mixin_apply_failed",
      "version": 1,
      "scope": { "producer": { "format": "minecraft_latest_log" } },
      "when": {
        "fact": {
          "kind": "minecraft.mixin_failure",
          "where": { "severity": "critical" },
          "ref": { "kind": "mod_id", "bind": "owner" },
          "bind": { "config": "config", "target": "target" }
        }
      },
      "effects": [
        {
          "finding": {
            "cause": "mod",
            "scope": "root_cause",
            "level": "likely",
            "candidate": { "owner_of": "owner" },
            "family": "known_signature",
            "weight": 10
          }
        }
      ],
      "text": {
        "headline": {
          "en": "{owner:owner} failed to apply its mixin {config} to {target}. It may be built for another game or loader version."
        },
        "why_not_sure": {
          "en": "A clash with another mod can make an innocent mod's patch fail."
        }
      },
      "repairs": [{ "disable_content": { "key": { "owner_of": "owner" } } }],
      "next_step": "confirm_experiment"
    },
    {
      "id": "mixin_config_owner",
      "version": 1,
      "when": {
        "fact": {
          "kind": "minecraft.mixin_failure",
          "where": { "severity": "critical" },
          "ref": { "kind": "mixin_config", "bind": "config_owner" },
          "bind": { "config": "config" }
        }
      },
      "effects": [
        {
          "signal": {
            "family": "known_signature",
            "candidate": { "owner_of": "config_owner" },
            "weight": 11,
            "cause": "mod"
          }
        }
      ],
      "text": {
        "headline": {
          "en": "{owner:config_owner} owns the mixin config {config} that failed to apply."
        }
      }
    },
    {
      "id": "mixin_target_owner",
      "version": 1,
      "when": {
        "fact": {
          "kind": "minecraft.mixin_failure",
          "where": { "severity": "critical" },
          "ref": { "kind": "class", "bind": "target_class" },
          "bind": { "target": "target" }
        }
      },
      "effects": [
        {
          "signal": {
            "family": "execution",
            "candidate": { "owner_of": "target_class" },
            "weight": 4,
            "cause": "mod"
          }
        }
      ],
      "text": {
        "headline": {
          "en": "The mixin failed on {target}, which {owner:target_class} provides."
        }
      }
    },
    {
      "id": "exception_names_mod_class",
      "version": 1,
      "when": {
        "fact": {
          "kind": "core.exception",
          "ref": { "kind": "named_class", "bind": "named_class" },
          "bind": { "message": "message" }
        }
      },
      "effects": [
        {
          "signal": {
            "family": "known_signature",
            "candidate": { "owner_of": "named_class" },
            "weight": 6,
            "cause": "mod"
          }
        }
      ],
      "text": {
        "headline": {
          "en": "The error names code that {owner:named_class} provides: {message}."
        }
      }
    },
    {
      "id": "data_error_names_mod",
      "version": 1,
      "when": {
        "fact": {
          "kind": "minecraft.data_error",
          "ref": { "kind": "mod_id", "bind": "mod" },
          "bind": { "namespace": "namespace", "message": "message" }
        }
      },
      "effects": [
        {
          "finding": {
            "cause": "mod",
            "scope": "root_cause",
            "level": "possible",
            "candidate": { "owner_of": "mod" },
            "family": "known_signature",
            "weight": 6
          }
        }
      ],
      "text": {
        "headline": {
          "en": "A data file in {owner:mod}'s namespace ({namespace}) could not be read: {message}. Repairing or reinstalling that mod is a possible next step."
        },
        "why_not_sure": {
          "en": "A broken data file can be unrelated to the crash, or another mod can change the same namespace."
        }
      },
      "next_step": "confirm_experiment"
    },
    {
      "id": "duplicate_mod",
      "version": 1,
      "scope": { "producer": { "format": "minecraft_latest_log" } },
      "when": {
        "fact": {
          "kind": "minecraft.duplicate_mod",
          "ref": { "kind": "mod_id", "bind": "dup" }
        }
      },
      "effects": [
        {
          "finding": {
            "cause": "mod",
            "scope": "root_cause",
            "level": "likely",
            "candidate": { "owner_of": "dup" },
            "family": "known_signature",
            "weight": 10
          }
        }
      ],
      "text": {
        "headline": {
          "en": "{owner:dup} was found more than once, so the loader may have used one copy in place of the other. Removing the extra copy is a likely next step."
        },
        "why_not_sure": {
          "en": "The duplicate is named, but the crash may not come from it."
        }
      },
      "repairs": [{ "disable_content": { "key": { "owner_of": "dup" } } }],
      "next_step": "confirm_experiment"
    },
    {
      "id": "mod_resolution_failed",
      "version": 1,
      "when": {
        "fact": {
          "kind": "minecraft.loader_problem",
          "where": { "kind": { "in": ["resolution", "missing_dependency"] } }
        }
      },
      "effects": [{ "finding": { "scope": "environment", "level": "likely", "cause": "missing_requirement" } }],
      "text": {
        "headline": {
          "en": "The mod loader could not resolve the installed mod set. A dependency may be missing, or two mods may declare requirements that cannot both be met."
        },
        "why_not_sure": {
          "en": "The loader reports the failed resolution, not a single mod that caused it."
        }
      },
      "next_step": "bisect"
    },
    {
      "id": "incompatible_mods",
      "version": 1,
      "when": {
        "fact": {
          "kind": "minecraft.loader_problem",
          "where": { "kind": "incompatible" }
        }
      },
      "effects": [{ "finding": { "scope": "environment", "level": "possible", "cause": "version_mismatch" } }],
      "text": {
        "headline": {
          "en": "The loader found mods it cannot run together or with this game version. Checking that each mod is built for this loader and game version is a likely next step."
        },
        "why_not_sure": {
          "en": "The loader reports the conflict, not one mod that is responsible for it."
        }
      },
      "next_step": "bisect"
    },
    {
      "id": "duplicate_classpath_libraries",
      "version": 1,
      "scope": { "producer": { "format": "minecraft_latest_log" } },
      "when": {
        "fact": {
          "kind": "minecraft.loader_problem",
          "where": { "kind": "duplicate_classpath" }
        }
      },
      "effects": [{ "finding": { "scope": "environment", "level": "likely", "cause": "other" } }],
      "text": {
        "headline": {
          "en": "The game started with two copies of the same library on its classpath, which the loader refuses to run with. This is usually a launcher problem: updating Agora and launching again is a likely next step."
        },
        "why_not_sure": {
          "en": "The log names the duplicate library, not a mod."
        }
      },
      "next_step": "confirm_experiment"
    },
    {
      "id": "mod_loading_error",
      "version": 1,
      "scope": { "producer": { "format": "minecraft_latest_log" } },
      "when": {
        "fact": {
          "kind": "minecraft.mod_error",
          "bind": { "message": "message" }
        }
      },
      "effects": [{ "finding": { "scope": "mechanism", "level": "possible", "cause": "mod" } }],
      "text": {
        "headline": {
          "en": "A mod failed to load: {message}. Its own log or the loader's error usually names the file and the reason."
        },
        "why_not_sure": {
          "en": "The loader reported a failed mod, but it did not establish that the crash came from it."
        }
      },
      "next_step": "confirm_experiment"
    },
    {
      "id": "broken_config",
      "version": 1,
      "scope": { "producer": { "format": "minecraft_latest_log" } },
      "when": {
        "any": [
          {
            "fact": {
              "kind": "minecraft.config_error",
              "bind": { "message": "message" }
            }
          },
          {
            "fact": {
              "kind": "core.exception",
              "where": {
                "message": {
                  "regex": "(?i)(failed to (load|read|parse).*config|config(uration)? file.*(invalid|corrupt|malformed|unreadable))"
                }
              },
              "bind": { "message": "message" }
            }
          }
        ]
      },
      "effects": [{ "finding": { "scope": "environment", "level": "possible", "cause": "setting" } }],
      "text": {
        "headline": {
          "en": "A configuration file could not be read: {message}. Moving it aside so the game can write a fresh one is a possible next step."
        },
        "why_not_sure": {
          "en": "A broken config can stop one mod or the game, but the log may not show what broke it."
        }
      },
      "next_step": "confirm_experiment"
    },
    {
      "id": "corrupted_world",
      "version": 1,
      "scope": { "producer": { "format": "minecraft_latest_log" } },
      "when": {
        "fact": {
          "kind": "minecraft.world_error",
          "bind": { "message": "message" }
        }
      },
      "effects": [{ "finding": { "scope": "environment", "level": "possible", "cause": "save" } }],
      "text": {
