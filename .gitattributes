# `agora skill` prints this file byte for byte; keep it identical on every OS.
crates/agora/skills/** text eol=lf

# Official plugin zips are hashed byte for byte by the release workflow and the
# signed registry. A CRLF checkout would build a different zip, so keep the
# package files LF on every OS.
packages/official/** text=auto eol=lf

# Crash fixtures are parsed byte for byte, and tests build their CRLF variants
# from the LF original. A CRLF checkout would hand them `\r\r\n`.
crates/*/tests/crash_fixtures/** -text
