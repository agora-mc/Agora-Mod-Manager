      "ini_checks": [
        {
          "file": "user/Skyrim.ini",
          "section": "General",
          "key": "uGridsToLoad",
          "default": "5",
          "expect": "5",
          "odd": true,
          "message": "uGridsToLoad is {value}. 5 is the game's default, and other values are known to crash the game and break saves; it must also be odd. Set it back to 5 unless you know why it is changed.",
          "source": "https://en.uesp.net/wiki/Skyrim_Mod:INI_Files"
        },
        {
          "file": "user/Skyrim.ini",
          "section": "General",
          "key": "uExterior Cell Buffer",
          "default": "36",
          "at_least_from": {
            "section": "General",
            "key": "uGridsToLoad",
            "default": "5",
            "add": 1,
            "square": true
          },
          "message": "uExterior Cell Buffer is {value}, but uGridsToLoad needs it to be at least {minimum} ((uGridsToLoad + 1)^2). A smaller buffer can crash the game or break saves.",
          "source": "https://en.uesp.net/wiki/Skyrim_Mod:INI_Files"
        }
