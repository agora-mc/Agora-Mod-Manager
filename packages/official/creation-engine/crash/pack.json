{
  "contract": 1,
  "games": [
    "skyrim-se"
  ],
  "sources": [
    {
      "id": "crash_logger",
      "where": {
        "root": "user_data",
        "location": "documents",
        "path": "My Games/Skyrim Special Edition/SKSE"
      },
      "match": {
        "glob": "crash-*.log"
      },
      "bind": [
        "pid_in_facts",
        {
          "time": {
            "before_s": 2,
            "after_s": 10
          }
        }
      ],
      "role": "primary",
      "privacy": "personal"
    },
    {
      "id": "trainwreck",
      "where": {
        "root": "user_data",
        "location": "documents",
        "path": "My Games/Skyrim Special Edition/SKSE"
      },
      "match": {
        "glob": "crash_*.log"
      },
      "bind": [
        {
          "time": {
            "before_s": 2,
            "after_s": 10
          }
        }
      ],
      "role": "primary",
      "privacy": "personal"
    }
  ],
  "parsers": [
    {
      "id": "crash_logger",
      "entry": {
        "script": {
          "export": "parseCrashLogger"
        }
      },
      "detect": {
        "all": [
          "(?m)^CrashLoggerSSE v"
        ],
        "any": [
          "(?m)^Unhandled exception ",
          "(?m)^SYSTEM SPECS:",
          "(?m)^ACCESS VIOLATION ANALYSIS:"
        ]
      }
    },
    {
      "id": "trainwreck",
      "entry": {
        "script": {
          "export": "parseTrainwreck"
        }
      },
      "detect": {
        "all": [
          "(?m)^trainwreck v"
        ],
        "any": [
          "(?m)^Unhandled exception ",
          "(?m)^SYSTEM SPECS:"
        ]
      }
    }
  ],
  "ref_maps": [
    {
      "kind": "module",
      "lookup": {
        "path": {
          "patterns": [
            "Data/SKSE/Plugins/{value}",
            "{value}"
          ]
        }
      },
      "match": "casefold"
    },
    {
      "kind": "plugin",
      "lookup": {
        "path": {
          "patterns": [
            "Data/{value}"
          ]
        }
      },
      "match": "casefold"
    },
    {
      "kind": "file",
      "lookup": {
        "path": {
          "patterns": [
            "Data/{value}"
          ],
          "archives": true
        }
      },
      "match": "casefold"
    }
  ],
  "roles": [
    {
      "kind": "module",
      "value": "SkyrimSE.exe",
      "match": "casefold",
      "role": "platform"
    },
    {
      "kind": "module",
      "value": "SkyrimVR.exe",
      "match": "casefold",
      "role": "platform"
    },
    {
