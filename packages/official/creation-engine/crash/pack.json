  "rules": [
    {
      "id": "module_near_top_of_stack",
      "version": 1,
      "when": {
        "fact": {
          "kind": "core.frame",
          "where": {
            "kind": "probable",
            "index": {
              "lte": 2
            }
          },
          "ref": {
            "kind": "module",
            "strength": "exec",
            "bind": "m"
          }
        }
      },
      "effects": [
        {
          "signal": {
            "family": "execution",
            "candidate": {
              "owner_of": "m"
            },
            "weight": 7
          }
        }
      ],
      "text": {
        "headline": {
          "en": "The crash happened in code from {owner:m}, near the top of the call stack."
        },
        "why_not_sure": {
          "en": "Code near the top of the stack is often where a crash shows, not where it started."
        }
      }
    },
    {
      "id": "module_lower_on_stack",
      "version": 1,
      "when": {
        "fact": {
          "kind": "core.frame",
          "where": {
            "kind": "probable",
            "index": {
              "gte": 3,
              "lte": 9
            }
          },
          "ref": {
            "kind": "module",
            "strength": "exec",
            "bind": "m"
          }
        }
      },
      "effects": [
        {
          "signal": {
            "family": "execution",
            "candidate": {
              "owner_of": "m"
            },
            "weight": 3
          }
        }
      ],
      "text": {
        "headline": {
          "en": "Code from {owner:m} was on the call stack when the game crashed."
        }
      }
    },
    {
      "id": "plugin_object_in_register",
      "version": 1,
      "when": {
        "fact": {
          "kind": "creation.object",
          "where": {
            "place": {
              "regex": "^R[A-Z0-9]{1,2}$"
            }
          },
          "ref": {
            "kind": "plugin",
            "strength": "object",
            "bind": "p"
          }
        }
      },
      "effects": [
        {
          "signal": {
            "family": "object_reference",
            "candidate": {
              "owner_of": "p"
            },
            "weight": 6
          }
        }
      ],
      "text": {
        "headline": {
          "en": "The game was handling a record from {owner:p} when it crashed."
        },
        "why_not_sure": {
          "en": "A record in use when the game crashed may be a victim rather than the cause."
        }
      }
    },
    {
      "id": "plugin_object_on_stack",
      "version": 1,
      "when": {
        "fact": {
          "kind": "creation.object",
          "where": {
            "place": {
              "regex": "^RSP"
            }
          },
          "ref": {
            "kind": "plugin",
            "strength": "object",
            "bind": "p"
          }
        }
      },
      "effects": [
        {
          "signal": {
            "family": "object_reference",
            "candidate": {
              "owner_of": "p"
            },
            "weight": 3
          }
        }
      ],
      "text": {
        "headline": {
          "en": "A record from {owner:p} was nearby in memory when the game crashed."
        }
      }
    },
    {
      "id": "file_in_register",
      "version": 1,
      "when": {
        "fact": {
          "kind": "creation.object",
          "where": {
            "place": {
              "regex": "^R[A-Z0-9]{1,2}$"
            }
          },
          "ref": {
            "kind": "file",
            "strength": "object",
            "bind": "f"
          }
        }
      },
      "effects": [
        {
          "signal": {
            "family": "object_reference",
            "candidate": {
              "owner_of": "f"
            },
            "weight": 5
          }
        }
      ],
      "text": {
        "headline": {
          "en": "The game was handling the file {owner:f} when it crashed."
        },
        "why_not_sure": {
          "en": "A damaged file is a common cause, but this one may only have been in use."
        }
      }
    },
    {
      "id": "out_of_memory",
      "version": 1,
      "when": {
        "fact": {
          "kind": "core.exception",
          "where": {
            "category": "oom"
          }
        }
      },
      "effects": [
        {
          "finding": {
            "scope": "environment",
            "level": "likely"
          }
        },
        {
          "trust": {
            "cap": "possible",
            "text": {
              "en": "The game ran out of memory, which can make any code crash, so a mod named here may only be where it ran out."
            }
          }
        }
      ],
      "text": {
        "headline": {
          "en": "The game ran out of memory. A larger Windows page file, or fewer high-resolution textures, often helps."
        },
        "why_not_sure": {
          "en": "A mod can cause the memory use, but the log does not say which."
        }
      },
      "next_step": "confirm_experiment"
    },
    {
      "id": "dll_dependency_failed_to_load",
      "version": 1,
      "when": {
        "fact": {
          "kind": "core.exception",
          "where": {
            "class": "C06D007E"
          }
        }
      },
      "effects": [
        {
          "finding": {
            "scope": "environment",
            "level": "possible"
          }
        }
      ],
      "text": {
        "headline": {
          "en": "A DLL could not load another library it needs. A missing requirement, or a mod built for a different game version, is a common reason."
        },
        "why_not_sure": {
          "en": "The log does not say which library was missing."
        }
      },
      "next_step": "confirm_experiment"
    },
    {
      "id": "content_catalog_format_mismatch",
      "version": 1,
      "when": {
        "all": [
          {
            "fact": {
              "kind": "core.exception",
              "where": {
                "class": "std::invalid_argument",
                "message": {
                  "glob": "*invalid stoull argument*"
                }
              }
            }
          },
          {
            "fact": {
              "kind": "creation.object",
              "where": {
                "type": {
                  "glob": "InstalledContent*"
                }
              }
            }
          }
        ]
      },
      "effects": [
        {
          "finding": {
            "scope": "environment",
            "level": "likely"
          }
        }
      ],
      "text": {
        "headline": {
          "en": "The game stopped while reading its installed-content catalog, on a value it expected to be a number. Another game build on this PC can rewrite ContentCatalog.txt in a format this build cannot read; moving that file aside lets the game rebuild it."
        },
        "why_not_sure": {
          "en": "This names the file the game was reading, not the mod or tool that changed it."
        }
      },
      "next_step": "confirm_experiment",
      "reference": "Tullius crash_signatures.json CONTENT_CATALOG_FORMAT_MISMATCH (GPL-3, idea)"
    },
    {
      "id": "missing_masters_known_site",
      "version": 1,
      "when": {
        "all": [
          {
            "fact": {
              "kind": "creation.game",
              "where": {
                "version": {
                  "version": {
                    "exact": [
                      "1.5.97",
                      "1.6.640"
                    ]
                  }
                }
              }
            }
          },
          {
            "any": [
              {
                "fact": {
                  "kind": "creation.exception_site",
                  "where": {
                    "module": {
                      "glob": "SkyrimSE.exe"
                    },
                    "offset": {
                      "glob": "*5E1F22"
                    }
                  }
                }
              },
              {
                "fact": {
                  "kind": "creation.exception_site",
                  "where": {
                    "module": {
                      "glob": "SkyrimSE.exe"
                    },
                    "offset": {
                      "glob": "*0198090"
                    }
                  }
                }
              }
            ]
          }
        ]
      },
      "effects": [
        {
          "finding": {
            "scope": "environment",
            "level": "likely"
          }
        }
      ],
      "text": {
        "headline": {
          "en": "This crash sits at an engine location that load orders with missing masters or unsupported ESL-format plugins reach. Check the missing-master list, and whether backported ESL support is needed for this game build."
        },
        "why_not_sure": {
          "en": "The location says the load order was incomplete; it does not name which plugin was missing."
        }
      },
      "next_step": "confirm_experiment",
      "reference": "Phostwood diagnoses.js:580 checkForMissingMasters (GPL-3)"
    },
    {
      "id": "cot_divide_by_zero",
      "version": 1,
      "when": {
        "all": [
          {
            "fact": {
              "kind": "core.exception",
              "where": {
                "class": "EXCEPTION_INT_DIVIDE_BY_ZERO"
              }
            }
          },
          {
            "fact": {
              "kind": "creation.plugin",
              "ref": {
                "kind": "plugin",
                "value": {
                  "glob": "ClimatesOfTamriel.esm"
                },
                "bind": "p"
              }
            }
          }
        ]
      },
      "effects": [
        {
          "finding": {
            "scope": "root_cause",
            "level": "possible",
            "candidate": {
              "owner_of": "p"
            },
            "family": "known_signature",
            "weight": 7
          }
        }
      ],
      "text": {
        "headline": {
          "en": "The crash was a divide-by-zero, and Climates of Tamriel is loaded. This mod is known to reach that failure through one of its records; replacing it or clearing the affected record from the save is the usual next step."
        },
        "why_not_sure": {
          "en": "A loaded mod that has had this failure reported is a lead, not a proof."
        }
      },
      "next_step": "confirm_experiment",
      "reference": "Phostwood diagnoses.js:3371 analyzeCoTDivideByZeroCrash (GPL-3)"
    },
    {
      "id": "d3d11_graphics_injector_fault",
      "version": 1,
      "when": {
        "fact": {
          "kind": "creation.exception_site",
          "where": {
            "module": {
              "glob": "d3d11.dll"
            }
          }
        }
      },
      "effects": [
        {
          "finding": {
            "scope": "environment",
            "level": "possible"
          }
        }
      ],
      "text": {
        "headline": {
          "en": "The fault is inside d3d11.dll, where a graphics injector such as ENB or ReShade puts its code. An injector binary built for a different game build is one common reason."
        },
        "why_not_sure": {
          "en": "The log does not say which injector, if any, is installed."
        }
      },
      "next_step": "confirm_experiment",
      "reference": "Phostwood diagnoses.js:5035 checkENBIssue (GPL-3); Tullius graphics_injection_rules.json (GPL-3)"
    },
    {
      "id": "win24h2_upscaler_fault",
      "version": 1,
      "when": {
        "all": [
          {
            "fact": {
              "kind": "creation.exception_site",
              "where": {
                "module": {
                  "glob": "KERNELBASE.dll"
                }
              }
            }
          },
          {
            "fact": {
              "kind": "core.frame",
              "ref": {
                "kind": "module",
                "value": {
                  "glob": "SkyrimUpscaler.dll"
                }
              }
            }
          }
        ]
      },
      "effects": [
        {
          "finding": {
            "scope": "environment",
            "level": "possible"
          }
        }
      ],
      "text": {
        "headline": {
          "en": "The crash reached KERNELBASE.dll with the Skyrim Upscaler on the stack. This pairing has been reported on Windows 11 24H2 with DLAA; disabling the upscaler is a small test."
        },
        "why_not_sure": {
          "en": "The log does not state the Windows build, so the 24H2 link is a report, not a check."
        }
      },
      "next_step": "confirm_experiment",
      "reference": "Phostwood diagnoses.js:1809 analyzeWin24H2UpscalerCrash (GPL-3)"
    },
    {
      "id": "dragons_eye_minimap_fault",
      "version": 1,
      "when": {
        "all": [
          {
            "fact": {
              "kind": "creation.script_extender_plugin",
              "ref": {
                "kind": "module",
                "value": {
                  "glob": "DragonsEyeMinimap.dll"
                },
                "bind": "d"
              }
            }
          },
          {
            "any": [
              {
                "fact": {
                  "kind": "creation.object",
                  "where": {
                    "rtti": {
                      "glob": "NiCamera"
                    }
                  }
                }
              },
              {
                "fact": {
                  "kind": "creation.object",
                  "where": {
                    "type": {
                      "glob": "BSImagespace*"
                    }
                  }
                }
              },
              {
                "fact": {
                  "kind": "core.frame",
                  "ref": {
                    "kind": "module",
                    "value": {
                      "glob": "DragonsEyeMinimap.dll"
                    }
                  }
                }
              }
            ]
          }
        ]
      },
      "effects": [
        {
          "signal": {
            "family": "known_signature",
            "candidate": {
              "owner_of": "d"
            },
            "weight": 6
          }
        }
      ],
